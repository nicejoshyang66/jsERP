@* 2026-11-09 14:30 added: 客戶 / 供應商基本資料 - one page for both, CLASSID A / B, Vue *@
@{
    // Title comes from the menu (PageTitleFilter); this text is only the default
    ViewData["Title"] = ViewData["Title"] ?? (ViewData["ClassName"] + "基本資料");
}

<!-- Vue app: company list of one class (A = 客戶, B = 供應商) -->
<div id="compay-app" v-cloak
     data-class-id="@ViewData["ClassId"]"
     data-class-name="@ViewData["ClassName"]"
     data-rows-url="@Url.Action("Rows", "BASComPay")"
     data-create-url="@Url.Action("Create", "BASComPay")"
     data-update-url="@Url.Action("Update", "BASComPay")"
     data-delete-url="@Url.Action("Delete", "BASComPay")">
    @Html.AntiForgeryToken()

    <h1 class="page-title">@ViewData["Title"]</h1>

    <!-- Search + Create New + rows per page --> <!-- 2026-11-09 15:46 modified: submit -> searchRows, add page size -->
    <form class="row g-2 mb-3 align-items-center" v-on:submit.prevent="searchRows">
        <div class="col-12 col-md-6 col-lg-4">
            <input type="text" class="form-control" v-model="keyword"
                   placeholder="代號 / 名稱 / 簡稱 / 統編" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-search"></i> 查詢
            </button>
        </div>
        <div class="col-auto">
            <button type="button" class="btn btn-success" v-on:click="openCreate">
                <i class="bi bi-plus-circle"></i> Create New
            </button>
        </div>
        <!-- 2026-11-09 15:46 added: rows per page (pushed to the right on md and up) -->
        <div class="col-12 col-md-auto ms-md-auto d-flex align-items-center">
            <label class="me-2 text-nowrap">每頁筆數</label>
            <select class="form-select" style="width:100px;"
                    v-model.number="pageSize" v-on:change="changePageSize">
                <option v-for="size in pageSizeOptions" v-bind:key="size" v-bind:value="size">{{ size }}</option>
            </select>
        </div>
    </form>

    <div v-if="error" class="alert alert-danger">{{ error }}</div>

    <!-- Company table. Less important columns are hidden on small screens -->
    <div class="table-responsive">
        <!-- 2026-11-09 15:46 modified: add table-striped (odd / even rows) -->
        <table class="table table-sm table-bordered table-hover table-striped align-middle">
            <thead class="table-primary">
                <tr>
                    <th class="text-nowrap">代號</th>
                    <th class="d-none d-lg-table-cell">名稱</th>
                    <th class="text-nowrap">簡稱</th>
                    <th class="text-nowrap">統編</th>
                    <th class="d-none d-xxl-table-cell">負責人</th>
                    <th class="d-none d-xl-table-cell">聯絡人</th>
                    <th class="d-none d-xxl-table-cell">公司地址</th>
                    <th class="d-none d-xxl-table-cell">郵寄地址</th>
                    <th class="d-none d-xxl-table-cell">帳單地址</th>
                    <th class="text-nowrap">電話</th>
                    <th class="d-none d-xl-table-cell">傳真</th>
                    <th class="d-none d-xxl-table-cell">Email</th>
                    <th class="d-none d-xxl-table-cell">備註</th>
                    <th>功能</th>
                </tr>
            </thead>
            <tbody>
                <tr v-if="loading">
                    <td colspan="14" class="text-muted">載入中…</td>
                </tr>
                <tr v-else-if="rows.length === 0">
                    <td colspan="14" class="text-muted">沒有資料。</td>
                </tr>
                <!-- 2026-11-09 15:46 modified: show only rows of this page -->
                <tr v-for="item in pagedRows" v-bind:key="item.debitId">
                    <td>{{ item.debitId }}</td>
                    <td class="d-none d-lg-table-cell">{{ item.debitName }}</td>
                    <td class="text-nowrap">{{ item.debitNick }}</td>
                    <td>{{ item.taxId }}</td>
                    <td class="d-none d-xxl-table-cell">{{ item.careerPic }}</td>
                    <td class="d-none d-xl-table-cell">{{ item.contact }}</td>
                    <td class="d-none d-xxl-table-cell">{{ item.address }}</td>
                    <td class="d-none d-xxl-table-cell">{{ item.mailingAddress }}</td>
                    <td class="d-none d-xxl-table-cell">{{ item.billingAddress }}</td>
                    <td class="text-nowrap">{{ item.tel }}</td>
                    <td class="d-none d-xl-table-cell text-nowrap">{{ item.fax }}</td>
                    <td class="d-none d-xxl-table-cell">{{ item.email }}</td>
                    <td class="d-none d-xxl-table-cell">{{ item.remark }}</td>
                    <td class="text-nowrap">
                        <!-- 2026-11-09 15:46 modified: add 瀏覽, buttons in Chinese -->
                        <button type="button" class="btn btn-info btn-sm me-1"
                                v-on:click="openView(item)">瀏覽</button>
                        <button type="button" class="btn btn-warning btn-sm me-1"
                                v-on:click="openEdit(item)">修改</button>
                        <button type="button" class="btn btn-danger btn-sm"
                                v-on:click="deleteRow(item)">刪除</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    <!-- 2026-11-09 15:46 modified: row info + Bootstrap pagination -->
    <div v-if="totalCount > 0" class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-2">
        <div>共 {{ totalCount }} 筆，目前顯示第 {{ startItem }} - {{ endItem }} 筆</div>

        <nav>
            <ul class="pagination flex-wrap mb-0">
                <li class="page-item" v-bind:class="{ disabled: page === 1 }">
                    <a class="page-link" href="#" v-on:click.prevent="goPage(1)">第一頁</a>
                </li>
                <li class="page-item" v-bind:class="{ disabled: page === 1 }">
                    <a class="page-link" href="#" v-on:click.prevent="goPage(page - 1)">上一頁</a>
                </li>
                <li class="page-item" v-for="n in pageNumbers" v-bind:key="n"
                    v-bind:class="{ active: n === page }">
                    <a class="page-link" href="#" v-on:click.prevent="goPage(n)">{{ n }}</a>
                </li>
                <li class="page-item" v-bind:class="{ disabled: page === totalPages }">
                    <a class="page-link" href="#" v-on:click.prevent="goPage(page + 1)">下一頁</a>
                </li>
                <li class="page-item" v-bind:class="{ disabled: page === totalPages }">
                    <a class="page-link" href="#" v-on:click.prevent="goPage(totalPages)">最末頁</a>
                </li>
            </ul>
        </nav>
    </div>

    <!-- ==================== Modal: company form ==================== -->
    <div class="modal fade" ref="formModal" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <form v-on:submit.prevent="saveRow" class="d-flex flex-column overflow-hidden">
                    <div class="modal-header">
                        <!-- 2026-11-09 15:46 modified: title for view mode -->
                        <h5 class="modal-title">{{ (isView ? '瀏覽' : (isNew ? '新增' : '修改')) + className }}</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <!-- 2026-11-09 15:46 added: fieldset disabled = all fields read only in view mode -->
                        <fieldset v-bind:disabled="isView">
                        <div class="row g-3">
                            <div class="col-12 col-md-4">
                                <label class="form-label">代號 <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" v-model="form.debitId"
                                       maxlength="25" v-bind:readonly="!isNew" required />
                            </div>
                            <div class="col-12 col-md-8">
                                <label class="form-label">名稱</label>
                                <input type="text" class="form-control" v-model="form.debitName" maxlength="60" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label">簡稱 <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" v-model="form.debitNick" maxlength="20" required />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label">統一編號</label>
                                <input type="text" class="form-control" v-model="form.taxId" maxlength="10" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label">負責人</label>
                                <input type="text" class="form-control" v-model="form.careerPic" maxlength="20" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label">聯絡人</label>
                                <input type="text" class="form-control" v-model="form.contact" maxlength="20" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label">電話</label>
                                <input type="text" class="form-control" v-model="form.tel" maxlength="50" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label">傳真</label>
                                <input type="text" class="form-control" v-model="form.fax" maxlength="50" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Email</label>
                                <input type="email" class="form-control" v-model="form.email" maxlength="50" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">公司地址</label>
                                <input type="text" class="form-control" v-model="form.address" maxlength="120" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">郵寄地址</label>
                                <input type="text" class="form-control" v-model="form.mailingAddress" maxlength="120" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">帳單地址</label>
                                <input type="text" class="form-control" v-model="form.billingAddress" maxlength="120" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">備註</label>
                                <textarea class="form-control" rows="2" v-model="form.remark"></textarea>
                            </div>
                        </div>
                        </fieldset> <!-- 2026-11-09 15:46 added -->
                        <div v-if="formError" class="alert alert-danger mt-3 mb-0 py-2">{{ formError }}</div>
                    </div>
                    <div class="modal-footer">
                        <!-- 2026-11-09 15:46 modified: view mode shows only 關閉 -->
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ isView ? '關閉' : '取消' }}</button>
                        <button type="submit" class="btn btn-primary" v-if="!isView" v-bind:disabled="busy">儲存</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/bascompay.js" asp-append-version="true"></script>
}

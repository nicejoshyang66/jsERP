@* 2026-10-29 10:51 added: 角色資料維護 - detail page of one user (user on top, tabs Roles / RoleGroups below) *@
@* 2026-10-29 15:44 modified: tabs on top, the user card is in the Roles tab, group is a select in the role form *@
@{
    // 2026-10-29 16:15 modified: title comes from the menu (PageTitleFilter); this text is only the default
    ViewData["Title"] = ViewData["Title"] ?? "角色資料維護";
}

<!-- Vue app: one user + roles / role groups -->
<div id="role-det-app" v-cloak
     data-user-id="@ViewBag.UserId"
     data-list-page-url="@Url.Action("List", "ZSYSRole")"
     data-user-one-url="@Url.Action("UserOne", "ZSYSRole")"
     data-user-roles-url="@Url.Action("UserRoles", "ZSYSRole")"
     data-role-create-url="@Url.Action("RoleCreate", "ZSYSRole")"
     data-role-update-url="@Url.Action("RoleUpdate", "ZSYSRole")"
     data-role-delete-url="@Url.Action("RoleDelete", "ZSYSRole")"
     data-group-list-url="@Url.Action("GroupList", "ZSYSRole")"
     data-group-create-url="@Url.Action("GroupCreate", "ZSYSRole")"
     data-group-update-url="@Url.Action("GroupUpdate", "ZSYSRole")"
     data-group-delete-url="@Url.Action("GroupDelete", "ZSYSRole")">
    @Html.AntiForgeryToken()

    <h1 class="page-title">@ViewData["Title"]</h1> <!-- 2026-10-29 16:20 added: menu caption, same as other pages; 2026-10-29 16:26 modified: class page-title -->

    <!-- 2026-10-29 15:44 modified: tabs on top (no title), 回使用者清單 on the right -->
    <ul class="nav nav-tabs align-items-center mb-3">
        <li class="nav-item">
            <a href="#" class="nav-link" v-bind:class="{ active: activeTab === 'roles' }"
               v-on:click.prevent="changeTab('roles')">Roles</a>
        </li>
        <li class="nav-item">
            <a href="#" class="nav-link" v-bind:class="{ active: activeTab === 'groups' }"
               v-on:click.prevent="changeTab('groups')">RoleGroups</a>
        </li>
        <li class="nav-item ms-auto">
            <a class="btn btn-outline-secondary btn-sm" v-bind:href="listPageUrl">
                <i class="bi bi-arrow-left"></i> 回使用者清單
            </a>
        </li>
    </ul>

    <div v-if="error" class="alert alert-danger">{{ error }}</div>

    <div v-if="user">
        <!-- ---------- Tab 1: the user + roles of this user ---------- -->
        <div v-if="activeTab === 'roles'">
            <!-- 2026-10-29 15:44 modified: the user card is now inside the Roles tab -->
            <div class="card shadow-sm mb-3">
                <div class="card-body p-2">
                    <div class="table-responsive">
                        <table class="table mb-0">
                            <tbody>
                                <tr>
                                    <th class="text-nowrap">代號</th>
                                    <td>{{ user.userId }}</td>
                                    <th class="text-nowrap">名稱</th>
                                    <td>{{ user.userName }}</td>
                                </tr>
                                <tr>
                                    <th class="text-nowrap">電話</th>
                                    <td>{{ user.tel }}</td>
                                    <th class="text-nowrap">手機</th>
                                    <td>{{ user.mobile }}</td>
                                </tr>
                                <tr>
                                    <th class="text-nowrap">備註</th>
                                    <td colspan="3">{{ user.description }}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <p>
                <button type="button" class="btn btn-success btn-sm" v-on:click="openRoleCreate">
                    <i class="bi bi-plus-circle"></i> 新增角色
                </button>
            </p>

            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle">
                    <thead class="table-primary">
                        <tr>
                            <th>角色代號</th>
                            <th>角色說明</th>
                            <th>所屬群組</th>
                            <th>功能</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr v-if="roleList.length === 0">
                            <td colspan="4" class="text-muted">沒有資料。</td>
                        </tr>
                        <tr v-for="item in roleList" v-bind:key="item.roleId">
                            <td>{{ item.roleId }}</td>
                            <td>{{ item.roleDesc }}</td>
                            <!-- 2026-10-29 15:44 modified: one role has one group; 群組 button removed -->
                            <td>{{ item.groupId }}</td>
                            <td class="text-nowrap">
                                <button type="button" class="btn btn-outline-primary btn-sm me-1"
                                        v-on:click="openRoleEdit(item)">Edit</button>
                                <button type="button" class="btn btn-outline-danger btn-sm"
                                        v-on:click="deleteRole(item)">Delete</button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ---------- Tab 2: all RoleGroups, highlight the groups of this user ---------- -->
        <div v-if="activeTab === 'groups'">
            <p>
                <button type="button" class="btn btn-success btn-sm" v-on:click="openGroupCreate">
                    <i class="bi bi-plus-circle"></i> 新增群組
                </button>
            </p>

            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle">
                    <thead class="table-primary">
                        <tr>
                            <th>群組代號</th>
                            <th>群組說明</th>
                            <th>此使用者的角色</th>
                            <th>功能</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr v-if="groupList.length === 0">
                            <td colspan="4" class="text-muted">沒有資料。</td>
                        </tr>
                        <!-- green row = this user is in the group -->
                        <tr v-for="item in groupList" v-bind:key="item.groupId"
                            v-bind:class="{ 'table-success': item.userRoleIds }">
                            <td>{{ item.groupId }}</td>
                            <td>{{ item.groupDesc }}</td>
                            <td>{{ item.userRoleIds }}</td>
                            <td class="text-nowrap">
                                <button type="button" class="btn btn-outline-primary btn-sm me-1"
                                        v-on:click="openGroupEdit(item)">Edit</button>
                                <button type="button" class="btn btn-outline-danger btn-sm"
                                        v-on:click="deleteGroup(item)">Delete</button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ==================== Modal: role form ==================== -->
    <div class="modal fade" ref="roleModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-scrollable">
            <div class="modal-content">
                <form v-on:submit.prevent="saveRole" class="d-flex flex-column overflow-hidden">
                    <div class="modal-header">
                        <h5 class="modal-title">{{ isNew ? '新增角色' : '修改角色' }}</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row g-3">
                            <!-- 2026-10-29 15:44 modified: labels without English -->
                            <div class="col-12 col-md-6">
                                <label class="form-label">角色代號 <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" v-model="roleForm.roleId"
                                       maxlength="12" v-bind:readonly="!isNew" required />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">角色說明</label>
                                <input type="text" class="form-control" v-model="roleForm.roleDesc" maxlength="40" />
                            </div>
                            <!-- 2026-10-29 15:44 modified: 使用者 removed (always the user of this page), select ROLEGROUP_ID -->
                            <div class="col-12">
                                <label class="form-label">所屬群組</label>
                                <select class="form-select" v-model="roleForm.groupId">
                                    <option value="">（未設定）</option>
                                    <option v-for="g in groupList" v-bind:key="g.groupId" v-bind:value="g.groupId">
                                        {{ g.groupId }} - {{ g.groupDesc }}
                                    </option>
                                </select>
                            </div>
                        </div>
                        <div v-if="formError" class="alert alert-danger mt-3 mb-0 py-2">{{ formError }}</div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                        <button type="submit" class="btn btn-primary" v-bind:disabled="busy">儲存</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- 2026-10-29 15:44 removed: Modal of the 群組 button -->

    <!-- ==================== Modal: role group form ==================== -->
    <div class="modal fade" ref="groupModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-scrollable">
            <div class="modal-content">
                <form v-on:submit.prevent="saveGroup" class="d-flex flex-column overflow-hidden">
                    <div class="modal-header">
                        <h5 class="modal-title">{{ isNew ? '新增群組' : '修改群組' }}</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label">群組代號 ROLEGROUP_ID <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" v-model="groupForm.groupId"
                                       maxlength="12" v-bind:readonly="!isNew" required />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">群組說明 ROLEGROUP_DESC</label>
                                <input type="text" class="form-control" v-model="groupForm.groupDesc" maxlength="40" />
                            </div>
                        </div>
                        <div v-if="formError" class="alert alert-danger mt-3 mb-0 py-2">{{ formError }}</div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                        <button type="submit" class="btn btn-primary" v-bind:disabled="busy">儲存</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/zsysrole-det.js" asp-append-version="true"></script>
}
